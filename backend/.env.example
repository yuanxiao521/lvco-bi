# =====================================================================
# LvcoBI Backend 环境变量模板
# 复制此文件为 .env 并填入真实值
# 重要：真实 .env 已在 .gitignore 内，绝不会提交到 git
# =====================================================================

# ── 数据库（docker-compose 默认值） ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lvco:CHANGE_ME@localhost:5432/lvco_bi

# ── JWT 鉴权 ──────────────────────────────────────────────────────
# 生产环境必须用强随机字符串（python -c "import secrets; print(secrets.token_urlsafe(64))"）
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 数据源凭据加密（必填） ────────────────────────────────────────
# 用户连接 MySQL/PostgreSQL 时填的密码会用此密钥 AES-256-GCM 加密后落库。
# 未配置时：创建/同步数据库型数据源会被拒绝（fail-closed），绝不会明文存库。
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
# 注意：密钥一旦用于存量数据就不能随意更换，否则旧密码解不开（会明确报错而不是静默失败）。
DB_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ── 数据源连接的网络边界（SSRF 防护） ─────────────────────────────
# 智能 BI 常连内网库，默认允许私网/回环；云元数据(169.254.169.254)、组播、
# 0.0.0.0 等保留地址始终禁止。多租户/线上环境可用白名单收口。
DB_ALLOW_PRIVATE_HOSTS=true
# 逗号分隔；非空时只允许命中项或其子域
DB_ALLOWED_HOSTS=
DB_CONNECT_TIMEOUT_SECONDS=10
# verify-ca / verify-full 时 CA 证书落地目录（DuckDB 只能读文件路径）
TLS_CA_DIR=./data/tls

# ── 连接健康检查（连接级定时探测） ────────────────────────────────
# 定时探测“这个连接现在还通不通”，结果写进 db_connections.health_*
CONNECTION_HEALTH_ENABLED=true
CONNECTION_HEALTH_INTERVAL_MINUTES=15
CONNECTION_HEALTH_MAX_PER_CYCLE=20
CONNECTION_HEALTH_MIN_AGE_MINUTES=5

# ── DuckDB（本地分析引擎） ────────────────────────────────────────
DUCKDB_DATA_DIR=./data/duckdb
DUCKDB_MEMORY_LIMIT=2GB
# true = 以只读模式打开（多进程并行读），写操作走 write_window 独占升级
DUCKDB_READ_ONLY=false

# ── LLM 服务（OpenAI 兼容） ───────────────────────────────────────
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=deepseek-v4-flash

# ── 文件上传 ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./data/uploads

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost,http://localhost:5173,http://127.0.0.1:5173

# ── Redis（可选，用于缓存/限流/任务队列） ─────────────────────────
REDIS_URL=redis://localhost:6379/0
# ARQ worker：对话/画布任务投递到 Redis 队列，由独立 worker 进程执行
TASK_QUEUE_ENABLED=false

# ── Langfuse 可观测性（可选） ─────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── MinIO 对象存储（可选） ────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false