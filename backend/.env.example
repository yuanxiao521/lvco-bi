# =====================================================================
# LvcoBI Backend 环境变量模板
# 复制此文件为 .env 并填入真实值
# 重要：真实 .env 已在 .gitignore 内，绝不会提交到 git
# =====================================================================

# ── 数据库（docker-compose 默认值） ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lvco:CHANGE_ME@localhost:5432/lvco_bi

# ── JWT 鉴权 ──────────────────────────────────────────────────────
# 生产环境必须用强随机字符串（python -c "import secrets; print(secrets.token_urlsafe(64))"）
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── DuckDB（本地分析引擎） ────────────────────────────────────────
DUCKDB_DATA_DIR=./data/duckdb
DUCKDB_MEMORY_LIMIT=2GB

# ── LLM 服务（OpenAI 兼容） ───────────────────────────────────────
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=deepseek-v4-flash

# ── 文件上传 ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./data/uploads

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost,http://localhost:5173,http://127.0.0.1:5173

# ── Redis（可选，用于缓存/限流） ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Langfuse 可观测性（可选） ─────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── MinIO 对象存储（可选） ────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
