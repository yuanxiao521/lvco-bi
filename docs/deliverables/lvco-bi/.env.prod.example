# ============================================
# Lvco BI 生产环境变量 — 所有变量必须填写
# ============================================

# PostgreSQL
DATABASE_URL=postgresql://lvco:YOUR_STRONG_PASSWORD@postgres:5432/lvco_bi

# JWT (生成: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

# OpenAI (AI 功能必需)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MinIO (对象存储必需)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# DB 凭证加密密钥 (生成: python -c "import secrets; print(secrets.token_hex(32))")
DB_CREDENTIALS_ENCRYPTION_KEY=

# Redis
REDIS_URL=redis://redis:6379/0
