# ============================================
# Lvco BI 生产环境变量 — 所有变量必须填写
# ============================================

# PostgreSQL
DATABASE_URL=postgresql://lvco:CHANGE_ME@postgres:5432/lvco_bi

# JWT (生成: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-this-to-a-random-string

# AI 配置（必需）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# MinIO（对象存储，使用默认值，Docker 容器内用 minio:9000）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# DB 凭证加密密钥（必填，没有默认值）
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
# 未配置时拒绝创建数据库型数据源（fail-closed），避免用户数据库密码明文落库。
DB_ENCRYPTION_KEY=

# 数据源连接网络边界（SSRF 防护）
# 线上多租户建议关闭私网直连并配置白名单收口
DB_ALLOW_PRIVATE_HOSTS=true
DB_ALLOWED_HOSTS=
DB_CONNECT_TIMEOUT_SECONDS=10

# Redis
REDIS_URL=redis://redis:6379/0

# DuckDB
DUCKDB_DATA_DIR=./data/duckdb
DUCKDB_MEMORY_LIMIT=2GB
