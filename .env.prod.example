# ============================================
# Lvco BI 生产环境变量 — 所有变量必须填写
# ============================================

# PostgreSQL
DATABASE_URL=postgresql://lvco:lvco_secret@postgres:5432/lvco_bi

# JWT (生成: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-this-to-a-random-string

# AI 配置（必需）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# MinIO（对象存储，使用默认值，Docker 容器内用 minio:9000）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# DB 凭证加密密钥（可选，代码中有默认值）
DB_CREDENTIALS_ENCRYPTION_KEY=

# Redis
REDIS_URL=redis://redis:6379/0

# DuckDB
DUCKDB_DATA_DIR=./data/duckdb
DUCKDB_MEMORY_LIMIT=2GB
